# Supabaseダッシュボード > Project Settings > API keys で確認できる値をコピーする。
# このファイル自体はコミットしてよい。実際の値は .env.local に書き、
# .env.local はコミットしない（.gitignoreで除外済み）。

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# 開発環境の /dev-login（テストアカウント切り替え）でのみ使う。
# NEXT_PUBLIC_ を付けない = ブラウザには一切送られない、サーバー専用の値。
# 本番環境には絶対に設定しないこと。
# 取得場所: Project Settings > API keys > secret keys（旧: service_role）
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx

# 「今日」画面のミッション評価（◎/○/△/×）ウィジェットを表示してよい
# 本人（DAYDLE運営者）のSupabase user_id（auth.usersのUUID）。
# 本番環境にも設定が必要（本人以外には表示されないが、値自体は
# ブラウザに送られるため機密情報ではない。実際の安全境界は
# supabase/migrations/0011_mission_ratings.sqlのRLS側）。
NEXT_PUBLIC_OWNER_USER_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
